{
    "name": "enuenan/users-roles-permissions",
    "description": "Filament User & Roles & Permissions",
    "keywords": [
        "enuenan",
        "laravel",
        "filament",
        "filament-packages",
        "filament-plugins",
        "filament-users-roles-permissions"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "enuenan\\UsersRolesPermissions\\": "src/",
            "enuenan\\UsersRolesPermissions\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "authors": [
        {
            "name": "enuenan",
            "email": "emoammerfershid@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "codewithdennis/filament-select-tree": "^4.0",
        "filament/filament": "^5.0",
        "ysfkaya/filament-phone-input": "^4.1",
        "wildside/userstamps": "^3.1",
        "filament/spatie-laravel-media-library-plugin": "^5.2",
        "spatie/laravel-package-tools": "^1.92",
        "erlandmuchasaj/laravel-gzip": "^1.2",
        "php-ffmpeg/php-ffmpeg": "^1.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "enuenan\\UsersRolesPermissions\\UsersRolesPermissionsServiceProvider"
            ]
        }
    }
